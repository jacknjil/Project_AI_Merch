rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public gallery/catalog data. Write requires auth — tightening to
    // admin-only (custom claims or a UID allowlist) is a follow-up; there is
    // no role system in the app yet, so this is the floor, not the final state.
    match /assets/{assetId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-user cart, already correctly scoped.
    match /users/{userId}/cart/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders are written by the Stripe webhook (Admin SDK, bypasses these
    // rules) with the owning user under `user.userId` — see
    // apps/frontend/src/app/api/stripe-webhook/route.ts. Scope client access
    // to the owning user only.
    match /orders/{orderId} {
      allow read, update: if request.auth != null && resource.data.user.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user.userId == request.auth.uid;
    }

    // Written only by the Stripe webhook via the Admin SDK, which bypasses
    // these rules entirely — no client write path exists or is needed.
    // Read is used by apps/frontend/src/app/orders/page.tsx to derive
    // payment_confirmed for the signed-in user's own orders.
    match /stripe_events/{eventId} {
      allow write: if false;
      allow read: if request.auth != null;
    }

    // Written only server-side via the Admin SDK
    // (apps/frontend/src/app/api/save-mockup/route.ts). Read is public for
    // apps/frontend/src/app/mockups/page.tsx.
    match /mockups/{mockupId} {
      allow read: if true;
      allow write: if false;
    }

    // Internal generation-pipeline job records. Written only server-side via
    // the Admin SDK (create-asset, generate-asset routes); no client code
    // reads or writes this collection.
    match /jobs/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
